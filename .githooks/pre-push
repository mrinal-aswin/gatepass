#!/usr/bin/env bash
# Refuses direct pushes to main: changes go through a branch and a pull request.
# A guardrail, not a security control: `git push --no-verify` bypasses it for a genuine hotfix.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked. Push a branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
